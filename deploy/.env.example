# 서버에서 이 파일을 deploy/.env로 복사해 값을 채운다. deploy/.env는 git에 올리지 않는다(.gitignore).

# Caddy가 인증서를 받을 도메인. IP만 있으면 <IP의 점을 하이픈으로>.sslip.io (예: 13-125-1-2.sslip.io)
# 인증서 없이 HTTP로만 열려면 :80
DOMAIN=

# DB (서버 안 Postgres 컨테이너)
DB_NAME=sonulim
DB_USERNAME=sonulim
# 길고 무작위인 값으로 (예: openssl rand -base64 24)
DB_PASSWORD=

# 32바이트 이상 (예: openssl rand -base64 48)
JWT_SECRET=

# PushSender 운영 구현 전까지 local. 구현 후 prod
SPRING_PROFILES_ACTIVE=local

# 필요할 때만: 호스트 포트(기본 80·443), JVM 옵션
# HTTP_PORT=80
# HTTPS_PORT=443
# JAVA_OPTS=-XX:MaxRAMPercentage=75
