# 로컬(docker-compose + application-local.yml 둘 다 이 기본값을 씀 — 로컬에서는 그대로 둬도 된다)
DB_PORT=5433
DB_NAME=sonulim
DB_USERNAME=sonulim
DB_PASSWORD=sonulim

# 로컬은 비워 두면 application-local.yml의 개발용 키를 쓴다. 지정한다면 32바이트 이상(HS256).
# JWT_SECRET=
JWT_ACCESS_EXPIRATION_SECONDS=3600
JWT_REFRESH_EXPIRATION_SECONDS=2592000

# FCM 서비스 계정 키. 키 파일은 레포의 secret/ 폴더(git·이미지 제외)나 레포 밖에 두고 절대 커밋하지 않는다.
# 비워 두면 local은 푸시를 로그로만 남기고, prod는 기동이 실패한다.
# - bootRun·서버: 키 파일 절대 경로
FIREBASE_CREDENTIALS_PATH=
# - docker compose: secret/ 안의 키 파일 이름(컨테이너 경로는 compose가 채운다)
# FIREBASE_KEY_FILE=

# prod 전용 — application-prod.yml은 기본값이 없어 반드시 채워야 한다
DB_HOST=changeme
