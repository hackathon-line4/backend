# 로컬(docker-compose + application-local.yml 둘 다 이 기본값을 씀 — 로컬에서는 그대로 둬도 된다)
DB_PORT=5433
DB_NAME=sonulim
DB_USERNAME=sonulim
DB_PASSWORD=sonulim

JWT_SECRET=changeme
JWT_ACCESS_EXPIRATION_SECONDS=3600
JWT_REFRESH_EXPIRATION_SECONDS=2592000

FIREBASE_CREDENTIALS_PATH=

# prod 전용 — application-prod.yml은 기본값이 없어 반드시 채워야 한다
DB_HOST=changeme
